# Copy to .env. Never commit .env.
# Local development (free): run `ollama serve` and `ollama pull qwen2.5:7b`
OLLAMA_API_BASE=http://localhost:11434

# Optional hosted providers
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# Force one model for every agent (overrides config/models.yaml)
# FAIRFARE_MODEL=ollama/qwen2.5:7b
